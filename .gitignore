# ---------------------------------------------------------------------------
# OS / editor / language caches / local tool state
# ---------------------------------------------------------------------------
.DS_Store
.thumbnail
.Rhistory
.claude/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
node_modules/

# Received archive whose contents are already extracted into eval/
eval/_received/

# Local duplicate of the authoritative integrated eval/ directory
B_eval/

# ---------------------------------------------------------------------------
# Datasets (A). The course submission must not contain the datasets, and these
# files are regenerated by A's pipeline. data/README.md explains how to obtain
# and rebuild them. EDA figures and data_summary.json are small and stay in Git
# because the report cites them.
# ---------------------------------------------------------------------------
data/*.parquet
data/*.duckdb
data/_duckdb_tmp/
data/_probe.txt
data/step2.log

# ---------------------------------------------------------------------------
# Per-user metric dumps (B/C/D). These are 17-52 MB intermediate files with one
# row per evaluated user. The aggregated *_results.csv and *_significance_*.csv
# next to them carry every number the report needs.
# ---------------------------------------------------------------------------
*user_metric_values*.csv
eval/final_eval/popularity_top100.csv

# ---------------------------------------------------------------------------
# Model checkpoints and training scratch
# ---------------------------------------------------------------------------
*.npz
*.npy
*.pt
*.pth
*.ckpt
*.pkl

# ---------------------------------------------------------------------------
# Study data (E). The frozen three-model package and generated payload are
# rebuilt by build/build-study.mjs from the validated inputs; the large
# catalogue/payload blobs do not belong in Git.
# ---------------------------------------------------------------------------
study-data/**/catalogue.json
!study-data/fixtures/catalogue.json
study-data/generated/*.json
!study-data/generated/.gitkeep

# ---------------------------------------------------------------------------
# Participant data (E). Never commit raw or identifiable study records. Only
# the empty templates in study/templates/ are tracked.
# ---------------------------------------------------------------------------
study/data/logs/
study/data/*.csv
study/results/participant-condition-analysis.csv

# ---------------------------------------------------------------------------
# Build artefacts and working notes
# ---------------------------------------------------------------------------
build/dc-changes-review.diff
submission/*.zip

# Local planning notes and duplicate working copies (canonical project records
# live under docs/ and models/d-hybrid/results/).
/coldstart-investigation.md
/今天.md
/PlayFinder-今日分工与最终提交清单.md

# Local source datasets
/raw/
